{
  "display": {
    "show_status_bar": true,
    "status_bar_side": "top",
    "use_icon": true
  },
  "editor": {
    "built_in_syntax": true
  },
  "lsp": {
    "launch_startup_editor": true,
    "epoll_timeout_ms": 16
  },
  "auto_complete":{
    "enabled":true,
    "window":{
      "show":true,
      "position_mode":"tracking",
      "width":20,
      "height":7
    }
  },
  "key_log": {
    "enabled": false,
    "buffer_size": 1024
  },
  "settings_language":"c"
}
